# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/ccmf?schema=public"

# Auth.js (gerar com: openssl rand -base64 32)
AUTH_SECRET=""
# URL canônica da app (produção: https://seu-dominio.railway.app)
AUTH_URL="http://localhost:3000"

# URL pública da aplicação (links na UI, e-mails, callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL canônica do site (SEO, sitemap, Open Graph, JSON-LD).
# Em produção: https://criancamaisfotogenica.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Opcional: códigos de verificação de webmaster tools
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# S3 (AWS ou compatível: MinIO, Cloudflare R2, etc.)
S3_REGION="us-east-1"
S3_BUCKET="ccmf-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# opcional: endpoint customizado para provedores compatíveis com S3
S3_ENDPOINT=""
# legado/opcional: leitura agora passa por /api/media/<storageKey>
# S3_PUBLIC_URL=""

# Asaas (gateway de pagamento)
# sandbox: https://api-sandbox.asaas.com/v3 | produção: https://api.asaas.com/v3
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
# ATENÇÃO: a chave do Asaas começa com "$" — escape com "\$" para o Next.js
# não tratar como expansão de variável (ex.: ASAAS_API_KEY="\$aact_...")
ASAAS_API_KEY=""
# token configurado no painel do Asaas para validar webhooks (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=""

# Nevoa Manager (WhatsApp — automações)
# Base deve apontar para /api do backend (com ou sem sufixo — normalizamos no client)
NEVOA_MANAGER_BASE_URL="https://nevoa-manager-backend-9e27f965f73e.herokuapp.com/api"
NEVOA_MANAGER_WEBHOOK_ID=""
NEVOA_MANAGER_TOKEN=""

# Nevoa Manager (tracking no site — carrega em todas as páginas)
NEXT_PUBLIC_NEVOA_TRACKING_TENANT="1234"
# NEXT_PUBLIC_NEVOA_TRACKING_SNIPPET_URL="https://nevoa-manager-backend-9e27f965f73e.herokuapp.com/api/public/tracking/snippet.js"

# Nevoa Manager (conversões server-side — venda_fechada no pagamento confirmado)
NEVOA_CONVERSION_API_TOKEN="nvconv_4Tdz-2UEgwHTcWdD8ZaU2YsCXdekp6am"

# Meta Pixel (Facebook / Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID="1258372234591295"

# Protege POST /api/workers/automations/run (obrigatório em produção)
AUTOMATION_WORKER_TOKEN=""
